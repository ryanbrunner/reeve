{
  "name": "reeve",
  "description": "A local kanban board where Claude plans, builds and tests each card in its own git worktree",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanbrunner/reeve.git"
  },
  "homepage": "https://github.com/ryanbrunner/reeve#readme",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev --workspace @reeve/server & npm run dev --workspace @reeve/web",
    "dev:server": "npm run dev --workspace @reeve/server",
    "dev:web": "npm run dev --workspace @reeve/web",
    "build": "npm run build --workspace @reeve/web",
    "start": "npm run start --workspace @reeve/server",
    "seed": "npm run seed --workspace @reeve/server",
    "cli": "node packages/cli/bin/reeve.js",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @reeve/server"
  }
}
